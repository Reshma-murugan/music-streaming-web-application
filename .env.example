# Backend API Base URL
# Point this to your deployed backend URL in production
# Default for local development: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Spotify API Credentials (optional - not currently in use)
# Get these from: https://developer.spotify.com/dashboard
# 1. Create a new app
# 2. Copy Client ID and Client Secret
# 3. Rename this file to .env and add your credentials
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
